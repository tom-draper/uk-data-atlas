{
	"name": "@uk-data-atlas/atlas-loader",
	"description": "Loads a complete atlas release by wiring the domain packages together.",
	"private": true,
	"license": "AGPL-3.0-only",
	"version": "0.0.0",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"dependencies": {
		"@uk-data-atlas/artifacts": "workspace:*",
		"@uk-data-atlas/catalogue": "workspace:*",
		"@uk-data-atlas/geography": "workspace:*",
		"@uk-data-atlas/map-tiles": "workspace:*",
		"@uk-data-atlas/terrain": "workspace:*",
		"@uk-data-atlas/postcodes": "workspace:*",
		"@uk-data-atlas/areas": "workspace:*",
		"@uk-data-atlas/relationships": "workspace:*",
		"@uk-data-atlas/geometry": "workspace:*",
		"@uk-data-atlas/places": "workspace:*",
		"@uk-data-atlas/measures": "workspace:*",
		"@uk-data-atlas/atlas-db": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^26.6.2",
		"typescript": "^7.0.2"
	}
}
