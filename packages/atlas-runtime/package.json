{
	"name": "@uk-data-atlas/atlas-runtime",
	"description": "Loads the atlas release from disk and serves its areas, geometry, places, postcodes, relationships and catalogue.",
	"private": true,
	"license": "AGPL-3.0-only",
	"version": "0.0.0",
	"type": "module",
	"sideEffects": false,
	"exports": {
		"./api": "./src/api/index.ts",
		"./areas": "./src/areas/index.ts",
		"./catalogue": "./src/catalogue/index.ts",
		"./loader": "./src/loader/index.ts",
		"./maps": "./src/maps/index.ts",
		"./places": "./src/places/index.ts",
		"./postcodes": "./src/postcodes/index.ts",
		"./relationships": "./src/relationships/index.ts",
		"./measures": "./src/measures/index.ts"
	},
	"scripts": {
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"dependencies": {
		"@uk-data-atlas/artifacts": "workspace:*",
		"@uk-data-atlas/catalogue": "workspace:*",
		"@uk-data-atlas/datasets": "workspace:*",
		"@uk-data-atlas/geography": "workspace:*",
		"@uk-data-atlas/map-tiles": "workspace:*",
		"@uk-data-atlas/search-index": "workspace:*",
		"@uk-data-atlas/shapefile": "workspace:*",
		"polygon-clipping": "0.15.7",
		"@uk-data-atlas/terrain": "workspace:*",
		"@uk-data-atlas/postcodes": "workspace:*",
		"@uk-data-atlas/areas": "workspace:*",
		"@uk-data-atlas/relationships": "workspace:*",
		"@uk-data-atlas/geometry": "workspace:*",
		"@uk-data-atlas/places": "workspace:*",
		"@uk-data-atlas/measures": "workspace:*",
		"@uk-data-atlas/atlas-db": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^26.6.2",
		"typescript": "^7.0.2"
	}
}
