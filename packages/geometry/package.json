{
	"name": "@uk-data-atlas/geometry",
	"description": "Stores, loads and queries area geometry.",
	"private": true,
	"license": "AGPL-3.0-only",
	"version": "0.0.0",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./src/index.ts",
		"./shapefile": "./src/shapefile/index.ts",
		"./terrain": "./src/terrain/index.ts",
		"./tiles": "./src/tiles/index.ts",
		"./tiles/node": "./src/tiles/node/index.ts",
		"./tiles/featureIds": "./src/tiles/featureIds.ts"
	},
	"scripts": {
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"dependencies": {
		"@uk-data-atlas/artifacts": "workspace:*",
		"@uk-data-atlas/atlas-db": "workspace:*",
		"@uk-data-atlas/geography": "workspace:*",
		"polygon-clipping": "0.15.7"
	},
	"devDependencies": {
		"@types/node": "^26.6.6",
		"typescript": "^7.0.2"
	}
}
