# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.profiles
/playwright-report/
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vscode

.agents

# public/data is generated by scripts/sync-public-data.mjs — not committed
/public/data/

# Immutable release snapshots are retained by the deployment volume or object
# store. Their contents are intentionally not duplicated in source control.
/api/public/atlas-releases/

# OS Open Roads is a locally downloaded national MBTiles source archive.
/data/oproad_mbtiles_gb.zip
/data/oproad_mbtiles_gb.zip:Zone.Identifier
/data/transport/os-open-roads/

# atomic-write temp files from precompile
data/precompiled/*.tmp

# Raw sources live in immutable GitHub Release assets. The compact browser
# payloads and compiled map assets below remain committed for Vercel builds.
/data/*
!/data/precompiled/
!/data/precompiled/**
data/precompiled/*.tmp
/.data-release/

AGENTS.md
CLAUDE.md

# API build output is built where it is served, not committed: its history
# grew the repository with every rebuild. The five files the website's docs
# pages read when the site builds stay tracked (see .vercelignore).
/api/public/*
!/api/public/data-catalog.json
!/api/public/export-manifest.json
!/api/public/boundary-releases.json
!/api/public/geography-inventory.json
!/api/public/map-resources.json
