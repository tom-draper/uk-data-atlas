# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.profiles
/playwright-report/
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# lookups fetched from the API for the precompile
/.cache/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vscode

.agents

# Generated browser datasets and boundaries.
/public/data/

# Legacy API build output from before data/build/artifacts.
/services/api/public/

# Raw sources live in immutable GitHub Release assets. Browser-ready payloads
# and compiled map assets live under public/data instead.
/data/*
!/data/build/
/.data-release/

AGENTS.md
CLAUDE.md

/services/api/dist/

# Compiled output the website and the API share, rebuilt by pnpm data:build.
# Only its README is tracked.
/data/build/*
!/data/build/README.md

# Python tooling for the generated API clients
/clients/python/.venv*/
__pycache__/
*.egg-info/
/clients/typescript/dist/
.pytest_cache/
.ruff_cache/
