# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.profiles
/playwright-report/
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# lookups fetched from the API for the precompile
/.cache/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vscode

.agents

# Browser-ready outputs are committed where Next serves them. Other data under
# public/ remains generated and ignored.
/public/data/*
!/public/data/datasets/
!/public/data/datasets/**
!/public/data/boundaries/
!/public/data/boundaries/**
/public/data/**/*.tmp

# Immutable release snapshots are retained by the deployment volume or object
# store. Their contents are intentionally not duplicated in source control.
/services/api/public/atlas-releases/

# OS Open Roads is a locally downloaded national MBTiles source archive.
/data/oproad_mbtiles_gb.zip
/data/oproad_mbtiles_gb.zip:Zone.Identifier
/data/transport/os-open-roads/

# Raw sources live in immutable GitHub Release assets. Browser-ready payloads
# and compiled map assets live under public/data instead.
/data/*
/.data-release/

AGENTS.md
CLAUDE.md

# API build output is built where it is served and is not committed.
# The website fetches place profiles and the docs catalogue over HTTP.
/services/api/public/*

/services/api/dist/
