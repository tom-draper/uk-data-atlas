# URL template for a web-accessible, CORS-enabled OS Open Roads vector-tile service.
# Download the OS Open Roads MBTiles archive, serve it, then use its tile URL.
# Example: https://tiles.example.com/os-open-roads/{z}/{x}/{y}.pbf
NEXT_PUBLIC_OS_OPEN_ROADS_TILE_URL=

# The source layer declared by that tile service. The OS MBTiles default is RoadLink.
NEXT_PUBLIC_OS_OPEN_ROADS_SOURCE_LAYER=RoadLink
