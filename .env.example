# URL template for a web-accessible, CORS-enabled OS Open Roads vector-tile service.
# `pnpm roads:serve` makes the locally downloaded MBTiles available at the URL below.
# Production should use a hosted vector-tile service instead.
NEXT_PUBLIC_OS_OPEN_ROADS_TILE_URL=

# The source layer declared by that tile service. The supplied OS MBTiles use road_link.
NEXT_PUBLIC_OS_OPEN_ROADS_SOURCE_LAYER=road_link
