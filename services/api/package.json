{
	"name": "@uk-data-atlas/api",
	"private": true,
	"license": "AGPL-3.0-only",
	"version": "0.0.0",
	"type": "module",
	"exports": {
		"./catalogues": "./src/catalogueLoader.ts"
	},
	"files": [
		"src",
		"scripts/serve.ts",
		"openapi.yaml"
	],
	"engines": {
		"node": ">=24 <27"
	},
	"scripts": {
		"audit:archive": "node scripts/audit-archive.mjs",
		"generate:query-rules": "tsx scripts/build-query-rules.ts",
		"build:cache": "tsx --max-old-space-size=2560 scripts/build-atlas-cache.ts",
		"build": "pnpm generate:query-rules && node scripts/build-runtime.mjs",
		"docs:index": "tsx scripts/build-readme-index.ts",
		"example:map": "tsx examples/correct-map.ts",
		"example:map-render": "tsx examples/correct-map-render.ts",
		"example:trend": "tsx examples/defensible-trend.ts",
		"example:sync": "tsx examples/reliable-sync.ts",
		"generate:clients": "tsx ../../clients/scripts/generate.mts",
		"start": "node dist/serve.mjs",
		"profile:startup": "tsx --max-old-space-size=4096 scripts/profile-startup.ts",
		"profile:memory": "node --expose-gc --max-old-space-size=1024 --import tsx scripts/profile-memory.ts",
		"smoke": "tsx scripts/smoke.ts",
		"contract:surface": "tsx scripts/build-api-surface.ts",
		"test": "tsx --max-old-space-size=4096 --test --test-concurrency=2 tests/*.test.ts tests/built/*.test.ts",
		"test:unbuilt": "tsx --test --test-concurrency=2 tests/*.test.ts",
		"typecheck": "pnpm generate:query-rules && tsc --noEmit -p tsconfig.json",
		"start:dev": "tsx scripts/serve.ts",
		"docs:examples": "tsx scripts/refresh-problem-examples.ts",
		"usage:report": "tsx scripts/usage-report.ts"
	},
	"dependencies": {
		"@uk-data-atlas/catalogue": "workspace:*",
		"@uk-data-atlas/geography": "workspace:*",
		"@uk-data-atlas/map-tiles": "workspace:*",
		"polygon-clipping": "0.15.7",
		"proj4": "2.22.0",
		"tsx": "^4.23.15",
		"yaml": "^2.9.1",
		"@uk-data-atlas/datasets": "workspace:*",
		"@uk-data-atlas/search-index": "workspace:*",
		"@uk-data-atlas/shapefile": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^26.6.2",
		"esbuild": "^0.28.2",
		"jsts": "2.12.1",
		"typescript": "^7.0.2"
	}
}
