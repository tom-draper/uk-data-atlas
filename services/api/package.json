{
	"name": "@uk-data-atlas/api",
	"private": true,
	"license": "AGPL-3.0-only",
	"version": "0.0.0",
	"type": "module",
	"exports": {
		"./catalogues": "./src/catalogueLoader.ts",
		"./geometry": "./src/simplifyGeometry.ts"
	},
	"files": [
		"src",
		"scripts/serve.ts",
		"openapi.yaml"
	],
	"engines": {
		"node": ">=24 <27"
	},
	"scripts": {
		"audit:archive": "node scripts/audit-archive.mjs",
		"build": "pnpm build:data && pnpm build:runtime",
		"docs:index": "tsx scripts/build-readme-index.ts",
		"example:map": "tsx examples/correct-map.ts",
		"example:map-render": "tsx examples/correct-map-render.ts",
		"example:trend": "tsx examples/defensible-trend.ts",
		"example:sync": "tsx examples/reliable-sync.ts",
		"build:area-inventory": "tsx scripts/build-area-inventory.ts",
		"build:atlas-pages": "tsx --max-old-space-size=3072 scripts/build-atlas-pages.ts",
		"build:atlas-lookups": "tsx --max-old-space-size=4096 scripts/build-atlas-lookups.ts",
		"build:atlas-release": "tsx scripts/build-atlas-release.ts",
		"build:boundary-registry": "tsx scripts/build-boundary-registry.ts",
		"build:crosswalk-inventory": "tsx --max-old-space-size=4096 scripts/build-crosswalk-inventory.ts",
		"build:relationship-paths": "tsx scripts/build-relationship-paths.ts",
		"build:location-projections": "tsx scripts/build-location-projections.ts",
		"build:derived-boundaries": "tsx scripts/build-derived-boundaries.ts",
		"build:geography-inventory": "tsx scripts/build-geography-inventory.ts",
		"build:terrain-catalogue": "tsx scripts/build-terrain-catalogue.ts",
		"start": "node dist/serve.mjs",
		"profile:startup": "tsx --max-old-space-size=4096 scripts/profile-startup.ts",
		"profile:memory": "node --expose-gc --max-old-space-size=1024 --import tsx scripts/profile-memory.ts",
		"smoke": "tsx scripts/smoke.ts",
		"contract:surface": "tsx scripts/build-api-surface.ts",
		"test": "tsx --max-old-space-size=4096 --test --test-concurrency=2 tests/*.test.ts tests/built/*.test.ts",
		"test:unbuilt": "tsx --test --test-concurrency=2 tests/*.test.ts",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"build:relationship-candidates": "tsx scripts/build-relationship-candidates.ts",
		"build:geometry-source-registry": "tsx scripts/build-geometry-source-registry.ts",
		"build:geometry-store": "tsx --max-old-space-size=4096 scripts/build-geometry-store.ts",
		"build:named-locations": "tsx scripts/build-named-locations.ts",
		"build:place-index": "tsx scripts/build-place-index.ts",
		"build:area-search-index": "tsx scripts/build-area-search-index.ts",
		"build:postcode-index": "tsx scripts/build-postcode-index.ts",
		"build:postcode-areas": "tsx scripts/build-postcode-areas.ts",
		"build:postcode-counts": "tsx scripts/build-postcode-counts.ts",
		"fetch:onspd": "tsx scripts/fetch-onspd.ts",
		"fetch:boundaries": "tsx --max-old-space-size=4096 scripts/fetch-ons-boundaries.ts",
		"refresh:onspd": "tsx scripts/fetch-onspd.ts",
		"build:data-catalog": "tsx scripts/build-data-catalog.ts",
		"build:export-manifest": "tsx scripts/build-export-manifest.ts",
		"build:lookup-manifest": "tsx scripts/build-lookup-manifest.ts",
		"build:measure-compatibility": "tsx scripts/build-measure-compatibility.ts",
		"build:analysis-geographies": "tsx scripts/build-analysis-geographies.ts",
		"build:analysis-geography-validation": "tsx scripts/build-analysis-geography-validation.ts",
		"build:operations": "tsx scripts/build-operations.ts",
		"build:query-rules": "tsx scripts/build-query-rules.ts",
		"build:map-resource": "tsx --max-old-space-size=4096 scripts/build-map-resource.ts",
		"build:validation-report": "tsx scripts/build-validation-report.ts",
		"build:runtime": "node scripts/build-runtime.mjs",
		"start:dev": "tsx scripts/serve.ts",
		"pack:named-locations": "tsx scripts/pack-named-locations.ts",
		"build:documents": "tsx --max-old-space-size=4096 scripts/build-evidence-documents.ts",
		"docs:examples": "tsx scripts/refresh-problem-examples.ts",
		"build:data": "node ../../scripts/build-data.mjs"
	},
	"dependencies": {
		"@uk-data-atlas/catalogue": "workspace:*",
		"@uk-data-atlas/geography": "workspace:*",
		"polygon-clipping": "0.15.7",
		"proj4": "2.22.0",
		"tsx": "^4.23.15",
		"yaml": "^2.9.1",
		"@uk-data-atlas/datasets": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^26.6.2",
		"esbuild": "^0.28.2",
		"jsts": "2.12.1",
		"typescript": "^7.0.2"
	}
}
