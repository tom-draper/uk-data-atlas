// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`a postcode batch reads its body under the size limits 1`] = `
{
  "after oversize": {
    "body": "{"apiVersion":"v1","atlasRelease":"sha256:registry","data":{"date":"2026-08","dateBasis":"directory-edition","boundaryRule":"included","releases":[{"geography":"localAuthority","boundaryRelease":"2026-05-uk-bgc","href":"/v1/boundary-releases/localAuthority/2026-05-uk-bgc","selection":{"policy":"latest-release-dated-on-or-before","date":"2026-08","sameMonth":false,"next":{"id":"2026-12-uk-bgc","month":"2026-12","title":"localAuthority 2026-12-uk-bgc","countries":["GB-ENG"],"href":"/v1/boundary-releases/localAuthority/2026-12-uk-bgc"}},"coverage":{"countries":["GB-ENG"]},"boundaryResolution":{"g",
    "headers": [
      "atlas-release: sha256:registry",
      "cache-control: no-store",
      "content-type: application/json",
      "vary: accept-encoding",
    ],
    "status": 200,
  },
  "oversize json": {
    "body": "{"type":"https://api.ukdataatlas.com/problems/content-too-large","title":"Content Too Large","status":413,"detail":"The request body is 9000034 bytes or more; at most 8388608 are read. Split the rows over several requests."}
",
    "headers": [
      "atlas-release: sha256:registry",
      "cache-control: no-store",
      "content-type: application/problem+json",
      "vary: accept-encoding",
    ],
    "status": 413,
  },
}
`;

