{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"types": ["node"],
		"resolveJsonModule": true
	},
	"include": ["src/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"]
}
