{
	"schemaVersion": 1,
	"measures": {
		"winning-party": {
			"label": "Winning party",
			"description": "The party whose candidate won the contest, or won most seats in a multi-member ward.",
			"reason": "The statistics tables hold votes by party, not the winner, so this is read from the observation tables."
		},
		"effective-votes": {
			"label": "Effective votes",
			"description": "Votes counted towards party totals in a local election, as the publisher defines them.",
			"reason": "The statistics tables hold the party votes it sums, not the sum, so it is read as their total."
		},
		"population-density": {
			"label": "Population density",
			"description": "Residents per square kilometre, computed from the population estimate and the area's land area.",
			"reason": "Derived by the API from two datasets, so it has no published series in the statistics tables."
		}
	},
