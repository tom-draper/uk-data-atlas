{
	"name": "@uk-data-atlas/api",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"engines": {
		"node": ">=24 <25"
	},
	"scripts": {
		"build": "pnpm build:archive-atlas-release && pnpm build:boundary-registry && pnpm build:derived-boundaries && pnpm build:area-inventory && pnpm build:named-locations && pnpm build:data-catalog && pnpm build:measure-compatibility && pnpm build:export-manifest && pnpm build:geometry-source-registry && pnpm build:crosswalk-inventory && pnpm build:relationship-paths && pnpm build:analysis-geographies && pnpm build:analysis-geography-validation && pnpm build:location-projections && pnpm build:relationship-candidates && pnpm build:geography-inventory && pnpm build:terrain-catalogue && pnpm build:lookup-manifest && pnpm build:map-resource && pnpm build:validation-report && pnpm build:atlas-release",
		"docs:index": "tsx scripts/build-readme-index.ts",
		"example:map": "tsx examples/correct-map.ts",
		"example:map-render": "tsx examples/correct-map-render.ts",
		"example:trend": "tsx examples/defensible-trend.ts",
		"example:sync": "tsx examples/reliable-sync.ts",
		"build:area-inventory": "tsx scripts/build-area-inventory.ts",
		"build:archive-atlas-release": "tsx scripts/archive-atlas-release.ts",
		"build:atlas-release": "tsx scripts/build-atlas-release.ts",
		"build:boundary-registry": "tsx scripts/build-boundary-registry.ts",
		"build:crosswalk-inventory": "tsx scripts/build-crosswalk-inventory.ts",
		"build:relationship-paths": "tsx scripts/build-relationship-paths.ts",
		"build:location-projections": "tsx scripts/build-location-projections.ts",
		"build:derived-boundaries": "tsx scripts/build-derived-boundaries.ts",
		"build:geography-inventory": "tsx scripts/build-geography-inventory.ts",
		"build:terrain-catalogue": "tsx scripts/build-terrain-catalogue.ts",
		"start": "tsx scripts/serve.ts",
		"smoke": "tsx scripts/smoke.ts",
		"contract:surface": "tsx scripts/build-api-surface.ts",
		"test": "tsx --test --test-concurrency=2 tests/*.test.ts",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"build:relationship-candidates": "tsx scripts/build-relationship-candidates.ts",
		"build:geometry-source-registry": "tsx scripts/build-geometry-source-registry.ts",
		"build:named-locations": "tsx scripts/build-named-locations.ts",
		"build:data-catalog": "tsx scripts/build-data-catalog.ts",
		"build:export-manifest": "tsx scripts/build-export-manifest.ts",
		"build:lookup-manifest": "tsx scripts/build-lookup-manifest.ts",
		"build:measure-compatibility": "tsx scripts/build-measure-compatibility.ts",
		"build:analysis-geographies": "tsx scripts/build-analysis-geographies.ts",
		"build:analysis-geography-validation": "tsx scripts/build-analysis-geography-validation.ts",
		"build:map-resource": "tsx scripts/build-map-resource.ts",
		"build:validation-report": "tsx scripts/build-validation-report.ts"
	},
	"devDependencies": {
		"@types/node": "^26.6.1",
		"polygon-clipping": "0.15.7",
		"proj4": "2.22.0",
		"tsx": "^4.23.13",
		"typescript": "^7.0.2",
		"yaml": "^2.9.1"
	}
}
