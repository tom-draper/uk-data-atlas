{
	"name": "@uk-data-atlas/api",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"build": "pnpm build:boundary-registry && pnpm build:geography-inventory",
		"build:boundary-registry": "tsx scripts/build-boundary-registry.ts",
		"build:geography-inventory": "tsx scripts/build-geography-inventory.ts",
		"start": "tsx scripts/serve.ts",
		"test": "tsx --test tests/*.test.ts",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"devDependencies": {
		"@types/node": "^26.4.1",
		"tsx": "^4.23.13",
		"typescript": "^7.0.2"
	}
}
