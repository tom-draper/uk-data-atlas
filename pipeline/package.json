{
	"name": "@uk-data-atlas/pipeline",
	"private": true,
	"license": "AGPL-3.0-only",
	"version": "0.0.0",
	"type": "module",
	"engines": {
		"node": ">=24 <27"
	},
	"scripts": {
		"build:assets": "tsx src/build-atlas-assets.ts",
		"fetch:onspd": "tsx src/sources/fetch-onspd.ts",
		"fetch:boundaries": "tsx --max-old-space-size=4096 src/sources/fetch-ons-boundaries.ts",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"dependencies": {
		"@duckdb/node-api": "1.4.5-r.1",
		"@uk-data-atlas/catalogue": "workspace:*",
		"@uk-data-atlas/datasets": "workspace:*",
		"@uk-data-atlas/geography": "workspace:*",
		"@uk-data-atlas/map-tiles": "workspace:*",
		"esbuild": "^0.28.2",
		"jsts": "2.12.1",
		"papaparse": "^5.7.0",
		"polygon-clipping": "0.15.7",
		"prettier": "3.9.7",
		"proj4": "^2.22.0",
		"topojson-client": "^3.1.0",
		"topojson-server": "^3.0.1",
		"topojson-simplify": "^3.0.3",
		"tsx": "^4.23.15",
		"yaml": "^2.9.1",
		"@uk-data-atlas/search-index": "workspace:*",
		"@uk-data-atlas/shapefile": "workspace:*",
		"@uk-data-atlas/artifacts": "workspace:*",
		"@uk-data-atlas/atlas-runtime": "workspace:*",
		"@uk-data-atlas/terrain": "workspace:*",
		"@uk-data-atlas/postcodes": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^26.6.2",
		"@types/papaparse": "^5.5.2",
		"typescript": "^7.0.2"
	}
