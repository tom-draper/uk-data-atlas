{
	"name": "@uk-data-atlas/pipeline",
	"private": true,
	"license": "AGPL-3.0-only",
	"version": "0.0.0",
	"type": "module",
	"engines": {
		"node": ">=24 <27"
	},
	"scripts": {
		"test": "vitest run --config ../vitest.config.mts --project pipeline",
		"test:built": "vitest run --config ../vitest.config.mts --project pipeline-built",
		"build:assets": "tsx src/stages/build-atlas-assets.ts",
		"fetch:onspd": "tsx src/sources/fetch-onspd.ts",
		"fetch:weight-sources": "tsx src/sources/fetch-weight-sources.ts",
		"fetch:boundaries": "tsx --max-old-space-size=3072 src/sources/fetch-ons-boundaries.ts",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"dependencies": {
		"@duckdb/node-api": "1.4.5-r.1",
		"@streamparser/json": "0.0.26",
		"@uk-data-atlas/artifacts": "workspace:*",
		"@uk-data-atlas/areas": "workspace:*",
		"@uk-data-atlas/atlas-loader": "workspace:*",
		"@uk-data-atlas/catalogue": "workspace:*",
		"@uk-data-atlas/datasets": "workspace:*",
		"@uk-data-atlas/geography": "workspace:*",
		"@uk-data-atlas/map-tiles": "workspace:*",
		"@uk-data-atlas/measures": "workspace:*",
		"@uk-data-atlas/places": "workspace:*",
		"@uk-data-atlas/postcodes": "workspace:*",
		"@uk-data-atlas/relationships": "workspace:*",
		"@uk-data-atlas/search-index": "workspace:*",
		"@uk-data-atlas/shapefile": "workspace:*",
		"@uk-data-atlas/terrain": "workspace:*",
		"esbuild": "^0.28.2",
		"jsts": "2.12.1",
		"papaparse": "^5.7.0",
		"polygon-clipping": "0.15.7",
		"prettier": "3.9.7",
		"proj4": "^2.22.0",
		"topojson-client": "^3.1.0",
		"topojson-server": "^3.0.1",
		"topojson-simplify": "^3.0.3",
		"tsx": "^4.23.15",
		"yaml": "^2.9.1",
		"@uk-data-atlas/atlas-db": "workspace:*",
		"@uk-data-atlas/geometry": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^26.6.2",
		"@types/papaparse": "^5.5.2",
		"typescript": "^7.0.2"
	}
}
