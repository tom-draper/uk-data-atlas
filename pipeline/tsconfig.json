{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"types": ["node"],
		"resolveJsonModule": true,
		"allowImportingTsExtensions": true,
		"allowJs": true
	},
	"include": ["src/**/*.ts", "src/**/*.mts"]
}
