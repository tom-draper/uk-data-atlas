import {
	assertCompleteBoundaryResources,
	parseBoundaryResources,
} from "../shared/boundaryResources";
import { readAtlasAssetText, readAtlasPayload } from "../shared/atlasSqlite";
import { ATLAS_LOOKUP_NAMES } from "./atlas-lookups";
import { createHash } from "node:crypto";
import { readFile, readdir, stat } from "node:fs/promises";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";
import { precompileFingerprints } from "../pipeline/src/precompile/fingerprint.mjs";

const args = process.argv.slice(2);
if (args.length !== 0) {
	throw new Error(
		"Usage: pnpm data:verify. This command accepts no arguments.",
	);
}

const root = dirname(dirname(fileURLToPath(import.meta.url)));
const datasets = join(root, "public", "data", "datasets");
const manifestPath = join(datasets, "dataset-manifest.json");

type Manifest = {
	precompiler?: { fingerprint?: string };
	datasets?: Array<{
		type: string;
		output: string;
		fingerprint?: string;
		compiled: { bytes: number; sha256: string };
	}>;
};

const fail = (message: string): never => {
	throw new Error(`${message} Run pnpm data:build locally.`);
};

for (const name of ATLAS_LOOKUP_NAMES)
	readAtlasAssetText(root, "lookups", name.replace(/\.json$/, ""));
for (const id of [
	"places-index",
	"place-facts",
	"ward-areas",
	"docs-catalogue",
])
	readAtlasAssetText(root, "pages", id);
for (const directory of ["precompiled", "atlas-lookups", "atlas-pages"])
	if (await stat(join(root, "public/data", directory)).catch(() => undefined))
		fail(`Obsolete public data remains in ${directory}.`);

const manifest = JSON.parse(
	await readFile(manifestPath, "utf8").catch(() =>
		fail("Local precompiled dataset manifest is missing or unreadable."),
	),
) as Manifest;
const compiledAt = (await stat(manifestPath)).mtimeMs;
async function verifyRawInputs(path: string): Promise<void> {
	const input = await stat(path);
	if (input.mtimeMs > compiledAt)
		fail(`Raw input ${path} changed since precompilation.`);
	if (input.isDirectory()) {
		for (const name of await readdir(path))
			await verifyRawInputs(join(path, name));
	}
}
await verifyRawInputs(join(root, "data/source"));

const expectedFingerprint = manifest.precompiler?.fingerprint;
if (!expectedFingerprint) fail("Precompiled data has no compiler fingerprint.");
const actual = await precompileFingerprints(root);
if (actual.pipeline !== expectedFingerprint)
	fail("Precompiled data was generated by different compiler inputs.");

const manifestTypes = (manifest.datasets ?? []).map(({ type }) => type);
const expectedTypes = Object.keys(actual.datasets);
if (
	manifestTypes.length !== expectedTypes.length ||
	expectedTypes.some((type) => !manifestTypes.includes(type))
)
	fail("Precompiled datasets are not the datasets the catalogue defines.");

for (const dataset of manifest.datasets ?? []) {
	if (dataset.fingerprint !== actual.datasets[dataset.type])
		fail(
			`Precompiled ${dataset.type} was generated by different compiler inputs.`,
		);
	const contents = Buffer.from(
		readAtlasPayload(root, `dataset:${dataset.output}`),
	);
	const digest = createHash("sha256").update(contents).digest("hex");
	if (
		contents.byteLength !== dataset.compiled.bytes ||
		digest !== dataset.compiled.sha256
	)
		fail(
			`Precompiled ${dataset.type} does not match dataset-manifest.json.`,
		);
}

await stat(join(root, "public", "data", "boundaries"));

const tilesManifestPath = join(
	root,
	"public",
	"data",
	"boundaries",
	"tiles.json",
);
const tiles = parseBoundaryResources(
	JSON.parse(
		await readFile(tilesManifestPath, "utf8").catch(() =>
			fail("Boundary map resource manifest is missing or unreadable."),
		),
	),
);
assertCompleteBoundaryResources(tiles);
for (const [release, { href, bytes }] of Object.entries(tiles.releases)) {
	const size = await stat(join(root, "public", href))
		.then(({ size }) => size)
		.catch(() => undefined);
	if (size !== bytes)
		fail(`Map resource for ${release} does not match tiles.json.`);
	await stat(join(root, "public", dirname(href), "properties.json")).catch(
		() => fail(`Missing boundary properties for ${release}.`),
	);
}
const publicFiles = await readdir(join(root, "public/data/boundaries"), {
	recursive: true,
});
if (publicFiles.some((file) => /\.topojson(?:\.gz)?$/.test(file)))
	fail("Legacy public boundary topology remains.");
console.log("Local precompiled data matches its manifest and compiler inputs.");
