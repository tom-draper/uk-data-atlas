{
	"name": "uk-data-atlas",
	"version": "0.2.15",
	"private": true,
	"license": "AGPL-3.0-only",
	"engines": {
		"node": ">=24 <27"
	},
	"scripts": {
		"data:verify": "tsx scripts/verify-data.mts",
		"data:build": "node scripts/build-data.mjs",
		"docs:sources": "tsx scripts/generate-sources-readme.mts",
		"data:download": "node scripts/data-release.mjs download",
		"data:publish": "node scripts/data-release.mjs publish",
		"dev": "node scripts/ensure-website-data.mjs && next dev --turbopack",
		"build": "node --import tsx scripts/link-boundary-tiles.ts && pnpm data:verify && node --import tsx scripts/build-seo-data.mts && next build --turbopack",
		"start": "next start",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest",
		"test:run": "vitest run",
		"test:e2e": "playwright test",
		"typecheck": "tsc --noEmit && pnpm --filter \"./packages/*\" --filter \"./clients/*\" typecheck && pnpm --dir services/mcp typecheck",
		"check": "pnpm typecheck && pnpm format:check && vitest run --project unit && pnpm --dir services/api typecheck && pnpm --dir services/api test:unbuilt && pnpm --dir services/mcp test",
		"check:full": "pnpm check && pnpm data:verify && vitest run --project built && pnpm --dir services/api test",
		"profile:atlas": "node scripts/profile-atlas-memory.mjs",
		"roads:serve": "node scripts/serve-os-open-roads.mjs"
	},
	"dependencies": {
		"@uk-data-atlas/catalogue": "workspace:*",
		"@uk-data-atlas/datasets": "workspace:*",
		"@uk-data-atlas/geography": "workspace:*",
		"@uk-data-atlas/map-tiles": "workspace:*",
		"@vercel/analytics": "^2.0.1",
		"lucide-react": "^1.48.0",
		"maplibre-gl": "^5.24.0",
		"next": "^16.3.6",
		"papaparse": "^5.7.0",
		"pmtiles": "^4.5.0",
		"polygon-clipping": "0.15.7",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"topojson-client": "^3.1.0",
		"yaml": "^2.9.1",
		"@uk-data-atlas/search-index": "workspace:*",
		"@uk-data-atlas/shapefile": "workspace:*",
		"@uk-data-atlas/artifacts": "workspace:*",
		"@uk-data-atlas/atlas-runtime": "workspace:*"
	},
	"devDependencies": {
		"@duckdb/node-api": "1.4.5-r.1",
		"@playwright/test": "^1.63.0",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^26.6.2",
		"@types/papaparse": "^5.5.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/topojson-client": "^3.1.5",
		"@types/topojson-server": "^3.0.4",
		"@types/topojson-simplify": "^3.0.3",
		"@types/topojson-specification": "^1.0.5",
		"babel-plugin-react-compiler": "^1.0.0",
		"jsts": "2.12.1",
		"prettier": "3.9.7",
		"proj4": "^2.22.0",
		"tailwindcss": "^4.3.3",
		"topojson-server": "^3.0.1",
		"topojson-simplify": "^3.0.3",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vite": "^8.2.1",
		"vitest": "^4.1.11"
	},
	"packageManager": "pnpm@12.5.1"
}
