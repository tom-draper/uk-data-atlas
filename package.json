{
  "name": "uk-data-atlas",
  "version": "0.1.5",
  "private": true,
  "scripts": {
    "precompile": "npx tsx scripts/precompile-data.ts",
    "dev": "node scripts/sync-public-data.mjs && npx tsx scripts/precompile-data.ts && next dev --turbopack",
    "build": "node scripts/sync-public-data.mjs && npx tsx scripts/precompile-data.ts && next build --turbopack",
    "start": "next start",
    "format": "prettier --write \"**/*.{ts,tsx}\" --use-tabs --tab-width 4",
    "test": "vitest",
    "test:run": "vitest run",
    "profile:atlas": "node scripts/profile-atlas-memory.mjs",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "lucide-react": "^1.23.0",
    "maplibre-gl": "^5.24.0",
    "next": "^16.2.10",
    "papaparse": "^5.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.1.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/topojson-client": "^3.1.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "prettier": "^3.9.4",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  },
  "packageManager": "pnpm@11.11.0+sha512.4463f65fd80ed80d69bc1d4bf163ee94f605c7380fc318bb5b2ebe15f8cd12d49c51a4d59e951b401e764d3b6ca751cbf51bc50ed7001a6bcb4935e684c34882"
}
