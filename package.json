{
	"name": "uk-data-atlas",
	"version": "0.2.8",
	"private": true,
	"license": "AGPL-3.0-only",
	"engines": {
		"node": ">=24 <27"
	},
	"scripts": {
		"data:download": "node scripts/data-release.mjs download",
		"data:publish": "node scripts/data-release.mjs publish",
		"data:verify-precompiled": "node scripts/data-release.mjs verify-precompiled",
		"docs:catalogue": "npx tsx scripts/build-docs-catalogue.mts",
		"precompile": "pnpm data:download && pnpm precompile:generate",
		"precompile:generate": "npx tsx scripts/generate-dataset-registry.ts && npx tsx scripts/generate-sources-readme.mts && npx tsx --max-old-space-size=4096 scripts/precompile-data.mts",
		"precompile:only": "npx tsx scripts/generate-dataset-registry.ts && npx tsx scripts/generate-sources-readme.mts && npx tsx --max-old-space-size=4096 scripts/precompile-data.mts --only",
		"precompile:if-needed": "node scripts/precompile-if-needed.mjs",
		"precompile:verify": "npx tsx scripts/verify-precompiled.mts",
		"boundaries:compile": "npx tsx scripts/compile-boundaries.mts",
		"lineage:build": "npx tsx --max-old-space-size=6144 scripts/build-area-lineage.mts",
		"containment:build": "npx tsx --max-old-space-size=6144 scripts/build-area-containment.mts",
		"seo:build": "npx tsx scripts/build-seo-data.mts",
		"dev": "pnpm precompile:if-needed && next dev --turbopack",
		"build": "pnpm precompile:verify && next build --turbopack",
		"hooks:install": "git config core.hooksPath .githooks",
		"start": "next start",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest",
		"test:run": "vitest run",
		"test:e2e": "playwright test",
		"typecheck": "tsc --noEmit && pnpm --filter \"./packages/*\" typecheck",
		"check": "pnpm typecheck && pnpm format:check && vitest run --project unit --project data && pnpm --dir services/api typecheck && pnpm --dir services/api test:unbuilt",
		"check:full": "pnpm precompile && pnpm boundaries:compile && pnpm --dir services/api build && pnpm lineage:build && pnpm containment:build --check && pnpm typecheck && pnpm format:check && pnpm test:run && pnpm --dir services/api typecheck && pnpm --dir services/api test",
		"profile:atlas": "node scripts/profile-atlas-memory.mjs",
		"roads:serve": "node scripts/serve-os-open-roads.mjs",
		"doctor": "npx react-doctor@latest"
	},
	"dependencies": {
		"@uk-data-atlas/catalogue": "workspace:*",
		"@uk-data-atlas/geography": "workspace:*",
		"lucide-react": "^1.48.0",
		"maplibre-gl": "^5.24.0",
		"next": "^16.3.6",
		"papaparse": "^5.7.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"topojson-client": "^3.1.0",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^26.6.2",
		"@types/papaparse": "^5.5.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/topojson-client": "^3.1.5",
		"@types/topojson-server": "^3.0.4",
		"@types/topojson-simplify": "^3.0.3",
		"@types/topojson-specification": "^1.0.5",
		"@uk-data-atlas/api": "workspace:*",
		"babel-plugin-react-compiler": "^1.0.0",
		"prettier": "3.9.7",
		"proj4": "^2.22.0",
		"tailwindcss": "^4.3.3",
		"topojson-server": "^3.0.1",
		"topojson-simplify": "^3.0.3",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vite": "^8.2.1",
		"vitest": "^4.1.11"
	},
	"packageManager": "pnpm@12.5.1"
}
